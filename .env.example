# ============================================================
#  Python vs Спорт — Пример конфигурации
#  Скопируйте этот файл в .env и поменяйте SECRET_KEY!
# ============================================================

# --- Безопасность ---
# ОБЯЗАТЕЛЬНО поменяйте это на свой уникальный ключ на продакшене!
# Сгенерировать новый: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-change-me-on-prod-1234567890

# Время жизни токена авторизации (в минутах). 480 = 8 часов.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Настройки Cookie ---
# Для локальной разработки (http://) должно быть false. 
# Для продакшена с HTTPS (https://) поставьте true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- База данных ---
# По умолчанию используется локальный SQLite-файл.
# Если хотите PostgreSQL, раскомментируйте строку ниже:
DATABASE_URL=sqlite:///./contest_web.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
